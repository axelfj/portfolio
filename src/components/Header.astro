---
import { LINKS } from "@consts"
const pathname = Astro.url.pathname
---
<header id="header" class="cv-header">
  <a class="cv-brand" href="/" aria-label="Axel Fernández — home">AF<span aria-hidden="true">.</span></a>
  <nav aria-label="Main navigation">{LINKS.map(link => <a href={link.HREF} aria-current={pathname === link.HREF ? "page" : undefined}>{link.TEXT}</a>)}</nav>
  <button id="header-theme-button" aria-label="Toggle light and dark theme"><svg width="20" height="20" aria-hidden="true"><use href="/ui.svg#sun" /></svg></button>
</header>
