---
import PageLayout from "@layouts/PageLayout.astro"
import { SITE, SOCIALS } from "@consts"
const expertise = ["React", "TypeScript", "Next.js", "Redux", "Design systems", "Storybook", "Node.js", ".NET", "Java", "PostgreSQL"]
const highlights = [
  { number: "01", title: "Architecture with a path to reuse", text: "Owning the first React implementation of an enterprise design system already used across 70+ Angular projects. Our application is the first adopter, with components intended for other teams to use." },
  { number: "02", title: "Technical direction, shared delivery", text: "Leading frontend technical direction for a seven-developer team. I make architectural decisions, coordinate with UX/UI and UK-based stakeholders, and help turn product requirements into implementation plans." },
  { number: "03", title: "Engineering beyond the interface", text: "Experience across Node.js, .NET, Java, and relational databases informs how I design frontend data flows, agree API contracts, and work with backend teams." },
]
---
<PageLayout title="Senior Software Engineer" description={SITE.DESCRIPTION}>
  <div class="cv-home">
    <section class="cv-hero" aria-labelledby="intro-title">
      <p class="cv-eyebrow">Axel Fernández Jiménez · Costa Rica</p>
      <h1 id="intro-title">Thoughtful interfaces.<br /><span>Systems built to grow.</span></h1>
      <p class="cv-role">Senior Software Engineer · Frontend Architecture & Technical Leadership</p>
      <p class="cv-intro">I build React applications and guide the decisions behind them. Currently leading frontend technical direction at Universal Music Group as a contractor, with ownership of an architecture migration and a React design-system implementation.</p>
      <div class="cv-actions">
        <a class="cv-button cv-primary" href="/work">Explore my experience <span aria-hidden="true">↗</span></a>
        <a class="cv-button" href="mailto:axelfeji@gmail.com">Let’s talk <span aria-hidden="true">↗</span></a>
        <a class="cv-text-link" href="/resume">View / print CV</a>
      </div>
      <div class="cv-facts" aria-label="Current scope">
        <div><strong>7 developers</strong><span>Team I guide technically</span></div>
        <div><strong>React architecture</strong><span>Migration & design-system ownership</span></div>
        <div><strong>English & Spanish</strong><span>International collaboration</span></div>
      </div>
    </section>
    <section class="cv-section" aria-labelledby="focus-title">
      <div class="cv-section-heading"><p class="cv-eyebrow">What I bring</p><h2 id="focus-title">From component decisions<br />to team direction.</h2></div>
      <div class="cv-highlight-grid">{highlights.map(item => <div class="cv-highlight"><span class="cv-number">{item.number}</span><h3>{item.title}</h3><p>{item.text}</p></div>)}</div>
    </section>
    <section class="cv-section cv-about" aria-labelledby="about-title">
      <div><p class="cv-eyebrow">Approach & toolkit</p><h2 id="about-title">Frontend depth.<br />Fullstack perspective.</h2></div>
      <div><p>I work where product, design, and engineering meet: reusable component architecture, frontend state management, API contracts, and delivery planning. I also interview frontend candidates and help establish engineering standards.</p><div class="cv-tags">{expertise.map(skill => <span>{skill}</span>)}</div></div>
    </section>
    <section class="cv-section cv-about" aria-labelledby="education-title">
      <div><p class="cv-eyebrow">Background</p><h2 id="education-title">Engineering & delivery.</h2></div>
      <div class="cv-education"><div><h3>MSc. Project Management</h3><p>Universitat de Barcelona · 2022</p></div><div><h3>BSc. Computing Engineering</h3><p>Tecnológico de Costa Rica · 2020</p></div></div>
    </section>
    <section id="contact" class="cv-contact" aria-labelledby="contact-title">
      <p class="cv-eyebrow">Get in touch</p><h2 id="contact-title">Let’s build something<br />that works well together.</h2>
      <div class="cv-actions">{SOCIALS.map(s => <a class="cv-text-link" href={s.HREF}>{s.NAME} <span aria-hidden="true">↗</span></a>)}</div>
    </section>
  </div>
</PageLayout>
