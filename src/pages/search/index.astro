---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import Search from "@components/Search"
const data = (await getCollection("projects")).filter(p => !p.data.draft)
---
<PageLayout title="Search" description="Search selected engineering work.">
  <TopLayout><h1 class="page-heading text-4xl">Search selected work</h1></TopLayout>
  <BottomLayout><Search client:load data={data} /></BottomLayout>
</PageLayout>
