---
import PageLayout from '@layouts/PageLayout.astro'
import {demos} from '../../lib/demos/catalog'
export function getStaticPaths(){return demos.map(demo=>({params:{demo:demo.slug},props:{demo}}))}
const {demo}=Astro.props
---
<PageLayout title={demo.title} description={demo.intro}>
  <div class="demo-page" data-demo={demo.slug}>
    <a class="demo-back" href={'/projects/'+demo.project+'/'}>← Project history & credits</a>
    <p class="demo-label">Browser adaptation · 2026</p>
    <h1>{demo.title}</h1><p class="demo-intro">{demo.intro}</p>
    <section class="lab" aria-label={demo.title+' interactive demo'}>
      <div id="demo-controls" class="demo-controls"></div>
      <div class="demo-stage">
        {demo.kind==='canvas' ? <canvas id="demo-canvas" width={demo.slug === "pacman" ? 600 : 900} height={demo.slug === "pacman" ? 670 : 450} role="img" aria-label={demo.title+' visualization. Use the controls and read the state summary below.'}>Your browser needs canvas support to draw the visualization.</canvas> : <div id="demo-board"></div>}
      </div>
      <p id="demo-status" class="demo-status" role="status" aria-live="polite">Loading interactive controls…</p>
      <div id="demo-details" class="demo-details"></div>
    </section>
    <div class="demo-notes"><section><h2>How to explore</h2><p>{demo.guide}</p></section><section><h2>About this version</h2><p>{demo.limits}</p></section></div>
    {demo.slug==='dou-shou-qi' && <p class="demo-credit"><a href="https://www.ymimports.com/pages/how-to-play-jungle" target="_blank" rel="noopener noreferrer">Rule reference: Yellow Mountain Imports ↗</a></p>}
    <p class="demo-credit">{demo.credits}</p>
    <p class="demo-credit"><a href={'/projects/'+demo.project+'/'}>Read about the original project</a> · <a href="/demos/">All demos</a></p>
    <noscript><p>JavaScript is needed to run this demo. The rules, history, and credits are available above.</p></noscript>
  </div>
</PageLayout>
<script>import '../../scripts/demo-lab'</script>
<style is:global>
.demo-page[data-demo="pacman"] .demo-stage canvas{max-width:600px;margin:auto}.pac-pad{display:flex;justify-content:center;gap:12px;margin-bottom:14px}.demo-page [hidden]{display:none!important}.demo-page{max-width:1080px;width:100%;margin:0 auto;padding:126px 28px 64px}.demo-back,.demo-credit a{text-decoration:underline;text-underline-offset:4px}.demo-label{font-size:.78rem;margin:28px 0 12px;color:var(--accent)}.demo-page h1{font-size:clamp(2.2rem,6vw,3.8rem);line-height:1.15;font-weight:700;letter-spacing:-.035em;color:#171717}.dark .demo-page h1{color:#fafafa}.demo-intro{font-size:1.15rem;line-height:1.7;max-width:700px;margin:18px 0 30px}.lab{border:1px solid #b7bdc8;border-radius:8px;overflow:hidden}.demo-controls{padding:16px;display:flex;flex-wrap:wrap;gap:12px;align-items:center;background:#f3f4f6;color:#252b35}.demo-controls label{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.demo-page button,.demo-page select,.demo-page input[type=number]{border:1px solid #959eaf;border-radius:4px;padding:8px 12px;background:#fff;color:#252b35;font:inherit}.demo-page button{cursor:pointer}.demo-page button:hover:not(:disabled){background:var(--accent-tint)}.demo-page button:disabled{opacity:.5;cursor:default}.demo-page button[aria-pressed=true]{background:var(--accent-solid);color:white}.demo-stage{background:#14171d;min-height:240px}.demo-stage canvas{display:block;width:100%;height:auto;touch-action:manipulation}.demo-status{padding:16px;border-top:1px solid #b7bdc8;min-height:58px;line-height:1.6}.demo-details{padding:0 16px 20px;line-height:1.7;overflow-x:auto}.demo-notes{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin:36px 0}.demo-notes h2{font-weight:700;font-size:1.15rem;margin-bottom:12px}.demo-notes p,.demo-credit{line-height:1.8}.demo-credit{font-size:.9rem;margin-top:16px;max-width:850px}.lab-table{border-collapse:collapse;width:100%;font-size:.88rem}.lab-table td,.lab-table th{padding:7px 10px;border:1px solid #9ea6b3;text-align:center}.lab-table .changed{background:#dce7f8;color:#243a60}.board-grid{display:grid;gap:3px;padding:16px;margin:auto;max-width:600px}.demo-page .board-cell{position:relative;aspect-ratio:1;min-width:0;padding:3px;background:#e7e7e5;border:2px solid transparent;color:#252b35;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1.2;font-weight:700;font-size:clamp(.65rem,2vw,.95rem);border-radius:3px}.demo-page .board-cell.side1{color:#145da0}.demo-page .board-cell.side2{color:#ae2828}.demo-page .board-cell.selected{border-color:#f6c958}.demo-page .board-cell.legal{background:#cfddf3;border-color:#6383b5}.demo-page .board-cell.attack{background:#f2b6ae;border-color:#b23424}.demo-page .board-cell.water{background:#8cc4d7}.demo-page .board-cell.trap{background:#e8c4a6}.demo-page .board-cell.den{background:#c9be97}.board-cell small{font-size:.65rem;font-weight:400;margin-top:3px}.demo-page .tic-board{max-width:360px;grid-template-columns:repeat(3,1fr)}.demo-page .tic-board .board-cell{font-size:2.2rem}.poison-table{padding:22px;color:#edf0f5}.cauldrons{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:22px}.demo-page .cauldron{background:#252c39;color:#fff;border:2px solid #77869f;min-height:135px;display:flex;flex-direction:column;gap:10px;align-items:center;justify-content:center}.demo-page .cauldron.legal{border-color:#9ab7e8}.poison-hand{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0}.demo-page .playing-card{font-size:1.15rem;min-width:50px;min-height:70px}.demo-page .playing-card.red{color:#b82f43}.demo-page .playing-card.selected{outline:3px solid #f4ca61;outline-offset:2px}.edge-inputs{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.edge-inputs label{font-size:.8rem}.demo-page .edge-inputs input{width:62px;padding:4px}.maze-access{display:grid;grid-template-columns:repeat(17,minmax(0,1fr));gap:1px;max-width:460px;margin-top:16px}.demo-page .maze-access button{aspect-ratio:1;min-width:0;padding:0;border-radius:0;font-size:.6rem}.maze-access button.wall{background:#424c5e;color:white}.demo-page input[type=range]{max-width:130px}.demo-page .score-value{font-size:.75rem}.demo-page .compact{font-size:.85rem}.dark .demo-label{color:var(--accent)}@media(max-width:650px){.demo-page{padding:116px 16px 40px}.demo-notes{grid-template-columns:1fr;gap:24px}.demo-controls{gap:8px;padding:12px;font-size:.85rem}.demo-page button,.demo-page select{padding:8px}.cauldrons{gap:6px}.demo-page .cauldron{padding:6px;font-size:.8rem}.board-grid{padding:8px;gap:2px}.demo-intro{font-size:1rem}.board-cell small{font-size:.55rem}}
</style>
